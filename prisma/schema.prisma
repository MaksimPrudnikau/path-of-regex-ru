generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model maps {
  id    Int    @id @unique(map: "maps_id_unique") @default(autoincrement())
  name  String @unique(map: "maps_name_unique")
  rank  Float
  regex String @unique(map: "maps_regex_unique")
  uniqueIndex Float
}
